---
import Layout from '@/layouts/Layout.astro';
import { site } from '@/content/site';
---
<Layout>
  <main id="main">
    <section id="hero" class="placeholder" aria-labelledby="hero-title">
      <p class="eyebrow metal-text">IEEE MSS {site.name} · {site.tagline}</p>
      <h1 id="hero-title" class="display metal-text">Coming Soon</h1>
    </section>
  </main>
</Layout>

<style>
  .placeholder { min-height: 100svh; display: grid; place-content: center; gap: var(--space-8); text-align: center; }
  .eyebrow.metal-text { letter-spacing: var(--track-wide); }
  h1 { font-size: var(--text-display); }
</style>
