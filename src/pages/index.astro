---
import Layout from '@/layouts/Layout.astro';
import Preloader from '@/components/Preloader/Preloader.astro';
import Nav from '@/components/Nav/Nav.astro';
import Hero from '@/components/Hero/Hero.astro';
import Section from '@/components/Section/Section.astro';
import About from '@/components/About/About.astro';
import Organisers from '@/components/Organisers/Organisers.astro';
import Speakers from '@/components/Speakers/Speakers.astro';
import Venue from '@/components/Venue/Venue.astro';
import Partners from '@/components/Partners/Partners.astro';
import { site, features } from '@/content/site';
---
<Layout>
  <Preloader />
  <Nav />
  <main id="main">
    <Hero />

    <About />

    {/* Launch-gated sections: not rendered at all until their flag in src/content/site.ts is true */}
    {features.speakers && <Speakers />}
    {features.host && <Venue />}
    {features.sponsors && <Partners />}

    <Organisers />

    {/* Phase 6 turns this into the footer */}
    <Section id="contact" heading="Stay in the Loop" eyebrow="Contact">
      <p class="lede">
        Follow <a href={site.socials.instagram.url} target="_blank" rel="noreferrer">@{site.socials.instagram.handle}</a> for announcements.
      </p>
    </Section>
  </main>
</Layout>

<style>
  .lede { max-width: 42rem; font-size: var(--text-lg); font-weight: 300; color: var(--fg-dim); }
  .lede a { color: var(--fg); text-decoration: underline; text-underline-offset: 0.3em; }
</style>
