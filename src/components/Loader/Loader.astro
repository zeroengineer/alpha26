---
/**
 * Opening loader → hero, as one sequence: the α outline draws itself exactly where the hero's chrome
 * α sits and a metal sheen rises inside it while the image and fonts arrive; then the black clears
 * around it, the hero's α resolves inside the outline, the type settles, and the outline dissolves.
 * Once per session; skipped for reduced motion (inline guard below).
 */
import { ALPHA_PATH, ALPHA_VIEWBOX } from '@/assets/alpha/alpha-path';
import { site } from '@/content/site';
---
<div class="loader" data-loader role="status" aria-label={`Loading ${site.name}`}>
  <script is:inline>
    try {
      if (sessionStorage.getItem('alpha26:loaded') === '1' || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.currentScript.parentElement.remove();
      }
    } catch (e) {}
  </script>
  <svg class="loader__alpha" viewBox={`0 0 ${ALPHA_VIEWBOX.w} ${ALPHA_VIEWBOX.h}`} aria-hidden="true">
    <defs>
      <linearGradient id="loader-metal" x1="0" y1="1" x2="0" y2="0">
        <stop offset="0" stop-color="#6a6a6a" />
        <stop offset="0.55" stop-color="#d9d9d9" />
        <stop offset="1" stop-color="#ffffff" />
      </linearGradient>
      <clipPath id="loader-clip"><path d={ALPHA_PATH} /></clipPath>
    </defs>
    <g clip-path="url(#loader-clip)">
      <rect class="loader__fill" data-loader-fill x="0" y="0" width={ALPHA_VIEWBOX.w} height={ALPHA_VIEWBOX.h} fill="url(#loader-metal)" />
    </g>
    <path class="loader__stroke" data-loader-stroke d={ALPHA_PATH} pathLength="1" />
  </svg>
  <p class="loader__label" data-loader-label>{site.name}<span> · {site.tagline}</span></p>
</div>

<style>
  .loader {
    position: fixed; inset: 0; z-index: var(--z-preloader); background: var(--bg);
    display: grid; place-items: center; pointer-events: all;
    /* mirror the hero poster box so the outline sits exactly on the hero α */
    --ph: 115svh;
  }
  @media (orientation: portrait) { .loader { --ph: max(100svh, 133.333vw); } }
  .loader__alpha {
    position: absolute; left: 50%; top: 50%;
    height: calc(var(--ph) * 0.54); width: auto; aspect-ratio: 1165 / 1000;
    transform: translate(calc(-50% + var(--ph) * 0.75 * 0.008), calc(-50% - var(--ph) * 0.009));
    overflow: visible;
  }
  .loader__stroke { fill: none; stroke: var(--fg); stroke-width: 1.5; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .loader__fill { opacity: 0.9; }
  .loader__label {
    position: absolute; left: 50%; bottom: max(3rem, 8svh); translate: -50% 0; white-space: nowrap;
    font-size: var(--text-xs); font-weight: 600; letter-spacing: var(--track-wide); text-transform: uppercase; color: var(--fg-dim);
    opacity: 0;
  }
  .loader__label span { color: var(--fg-mute); }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-loader]', () => import('./island'), { strategy: 'load' });
</script>
