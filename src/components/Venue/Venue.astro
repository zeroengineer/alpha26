---
/** The Venue (flag: host). Host institution card with photo, description and an optional map embed. */
import { Image } from 'astro:assets';
import Section from '@/components/Section/Section.astro';
import { host } from '@/content/organisers';
import { resolveImage } from '@/lib/images';
---
<Section id="venue" heading={host.heading} eyebrow={host.eyebrow} class="venue">
  <div class="venue__grid" data-venue>
    <figure class="venue__media" data-venue-media>
      <Image src={resolveImage(host.image.src)} alt={host.image.alt} widths={[600, 1000, 1400]} sizes="(max-width: 900px) 100vw, 60vw" loading="lazy" decoding="async" />
    </figure>
    <div class="venue__body" data-venue-body>
      <p class="eyebrow">{host.city}</p>
      <h3 class="venue__name">{host.name}</h3>
      <p class="venue__text">{host.description}</p>
      <dl class="venue__facts">
        <div><dt>Format</dt><dd>Two-day residential</dd></div>
        <div><dt>Stay</dt><dd>On campus (details to follow)</dd></div>
      </dl>
    </div>
  </div>
  {host.mapEmbedUrl && (
    <div class="venue__map">
      <iframe src={host.mapEmbedUrl} title={`Map: ${host.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  )}
</Section>

<style>
  .venue__grid { display: grid; gap: var(--space-8); }
  @media (min-width: 900px) { .venue__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; } }
  .venue__media { aspect-ratio: 16 / 10; overflow: hidden; border: 1px solid var(--line); background: var(--surface); opacity: 0; }
  .venue__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .venue__body { display: grid; gap: var(--space-4); opacity: 0; }
  .venue__name { font-size: var(--text-xl); font-weight: 400; letter-spacing: -0.01em; }
  .venue__text { font-weight: 300; color: var(--fg-dim); }
  .venue__facts { display: grid; gap: var(--space-3); margin-top: var(--space-4); border-top: 1px solid var(--line); }
  .venue__facts div { display: grid; grid-template-columns: 6rem minmax(0, 1fr); padding-block: var(--space-3); border-bottom: 1px solid var(--line); }
  .venue__facts dt { font-size: var(--text-xs); letter-spacing: var(--track-eyebrow); text-transform: uppercase; color: var(--fg-dim); }
  .venue__map { margin-top: var(--space-8); aspect-ratio: 21 / 9; border: 1px solid var(--line); overflow: hidden; }
  .venue__map iframe { width: 100%; height: 100%; border: 0; filter: grayscale(1) invert(0.92) contrast(1.1); }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('#venue', () => import('./island'));
</script>
