---
/**
 * 0N — Stay in the Loop (nav: Contact) + site footer.
 * Instagram and email now; the registration CTA appears when features.registration is on.
 */
import { Image } from 'astro:assets';
import Section from '@/components/Section/Section.astro';
import { site, features } from '@/content/site';
import Instagram from '@/assets/icons/instagram.svg';
import mss from '@/assets/brand/ieee-mss-lockup.png';
import ieee from '@/assets/brand/ieee.png';
const year = new Date().getFullYear();
---
<Section id="contact" heading="Stay in the Loop" eyebrow="Contact" station="contact" align="center" class="contact">
  <div class="contact__grid" data-contact>
    <p class="contact__lede">
      Dates, speakers and registration are announced first on Instagram. Follow along — or write to the
      Industry Relations Committee directly.
    </p>
    <ul class="contact__links">
      <li>
        <a class="contact__link" href={site.socials.instagram.url} target="_blank" rel="noreferrer" data-contact-link>
          <span class="contact__label eyebrow">Instagram</span>
          <span class="contact__value"><Instagram width={18} height={18} aria-hidden="true" />@{site.socials.instagram.handle}</span>
          <span class="contact__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      <li>
        <a class="contact__link" href={`mailto:${site.socials.email}`} data-contact-link>
          <span class="contact__label eyebrow">Email</span>
          <span class="contact__value">{site.socials.email}</span>
          <span class="contact__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
      {features.registration && (
        <li>
          <a class="contact__link contact__link--cta" href={site.registrationUrl} data-contact-link data-register>
            <span class="contact__label eyebrow">Registration</span>
            <span class="contact__value">Register for {site.name}</span>
            <span class="contact__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      )}
    </ul>
  </div>

  <p class="contact__statement display metal-text" data-soft aria-hidden="true">Built to Become</p>
</Section>

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Image src={mss} alt="IEEE Malabar Subsection" width={438} height={88} loading="lazy" />
      <Image src={ieee} alt="IEEE" width={411} height={120} loading="lazy" />
    </div>
    <p class="footer__meta">
      © {year} {site.organiser} · {site.committee}. {site.name} — {site.tagline}.
    </p>
    <a class="footer__top" href="#hero" data-nav-link="hero">Back to top ↑</a>
  </div>
</footer>

<style>
  .contact__grid { display: grid; gap: var(--space-8); max-width: 64rem; margin-inline: auto; padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  @media (min-width: 900px) { .contact__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; } }
  .contact__lede { max-width: 28rem; font-weight: 300; color: var(--fg-dim); font-size: var(--text-lg); }
  .contact__links { border-top: 1px solid var(--line); }
  .contact__link {
    display: grid; grid-template-columns: 7rem minmax(0, 1fr) auto; align-items: center; gap: var(--space-4);
    padding-block: var(--space-6); border-bottom: 1px solid var(--line); transition: padding-left var(--dur-fast) var(--ease-out);
  }
  .contact__link:hover { padding-left: var(--space-3); }
  .contact__value { display: inline-flex; align-items: center; gap: 0.5em; font-size: var(--text-lg); font-weight: 300; min-width: 0; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .contact__link { grid-template-columns: minmax(0, 1fr) auto; }
    .contact__label { grid-column: 1 / -1; }
  }
  .contact__value svg { width: 1em; height: 1em; }
  .contact__arrow { color: var(--fg-dim); transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast); }
  .contact__link:hover .contact__arrow { transform: translate(3px, -3px); color: var(--fg); }
  .contact__link--cta .contact__value { color: var(--fg); font-weight: 400; }

  .contact__statement {
    margin-top: clamp(5rem, 12vw, 10rem); text-align: center;
    font-size: clamp(1.4rem, 0.5rem + 4vw, 4.5rem); letter-spacing: 0.6em; text-indent: 0.6em; text-wrap: balance;
  }

  .footer { position: relative; background: var(--bg); border-top: 1px solid var(--line); padding-block: var(--space-8); }
  .footer__inner { display: grid; gap: var(--space-6); align-items: center; }
  @media (min-width: 900px) { .footer__inner { grid-template-columns: auto minmax(0, 1fr) auto; } }
  .footer__brand { display: flex; align-items: center; gap: var(--space-8); }
  .footer__brand img:first-child { height: 1.5rem; width: auto; }
  .footer__brand img:last-child { height: 1.6rem; width: auto; }
  .footer__meta { font-size: var(--text-xs); letter-spacing: 0.05em; color: var(--fg-dim); }
  .footer__top { font-size: var(--text-xs); letter-spacing: var(--track-nav); text-transform: uppercase; color: var(--fg-dim); }
  .footer__top:hover { color: var(--fg); }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('#contact', () => import('./island'));
</script>
