---
/**
 * 0N — The Team: who builds ALPHA (IEEE MSS + Industry Relations Committee, descriptive content),
 * then In Frames: photos from previous events, each carrying basic event details, with a lightbox.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/Section/Section.astro';
import { organisers } from '@/content/organisers';
import { resolveImage } from '@/lib/images';
import mss from '@/assets/brand/ieee-mss-lockup.png';

const frames = await Promise.all(
  (await getCollection('gallery')).map(async (g) => {
    const meta = resolveImage(g.data.image.src);
    const full = await getImage({ src: meta, format: 'webp', width: 1800, quality: 82 });
    return { ...g.data, meta, full: full.src };
  }),
);
---
<Section id="organisers" heading={organisers.heading} eyebrow={organisers.eyebrow} class="org">
  <div class="team" data-organisers>
    <article class="team__card" data-team-card>
      <Image class="team__logo" src={mss} alt="" width={438} height={88} />
      <h3 class="team__name">{organisers.org.name}</h3>
      <p class="team__text">{organisers.org.description}</p>
      <a class="team__link" href={organisers.org.url} target="_blank" rel="noreferrer">
        {organisers.org.url.replace('https://', '')} <span aria-hidden="true">↗</span>
      </a>
    </article>
    <article class="team__card" data-team-card>
      <span class="team__mark metal-text" aria-hidden="true">IRC</span>
      <h3 class="team__name">{organisers.committee.name}</h3>
      <p class="team__text">{organisers.committee.description}</p>
      <ul class="team__focus">
        {organisers.committee.focus.map((f, i) => (
          <li><span class="team__focus-no">{String(i + 1).padStart(2, '0')}</span>{f}</li>
        ))}
      </ul>
    </article>
  </div>

  <!-- In Frames -->
  <div class="block" id="gallery">
    <header class="block__head">
      <div>
        <p class="section-no"><span>Previous events</span></p>
        <h3 class="block__title metal-text">{organisers.galleryHeading}</h3>
      </div>
      <p class="block__lede">{organisers.galleryLede}</p>
    </header>
    <ul class="frames" data-gallery>
      {frames.map((f, i) => (
        <li class:list={['frame', { 'frame--wide': f.span === '2' }]} data-gallery-item>
          <button
            type="button"
            class="frame__btn"
            data-lightbox-open={i}
            data-full={f.full}
            data-alt={f.image.alt}
            data-event={f.event}
            data-year={f.year}
            data-detail={f.detail}
            aria-label={`Open: ${f.event} ${f.year} — ${f.image.alt}`}
          >
            <Image src={f.meta} alt={f.image.alt} widths={[400, 700, 1000]} sizes={f.span === '2' ? '(max-width: 768px) 100vw, 40rem' : '(max-width: 768px) 50vw, 20rem'} loading="lazy" decoding="async" />
            <span class="frame__cap">
              <span class="frame__meta"><b>{f.event}</b><i aria-hidden="true"></i>{f.year}</span>
              <span class="frame__detail">{f.detail}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M20 12H4m6-6-6 6 6 6"/></svg>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" data-lightbox-img alt="" />
      <figcaption class="lightbox__cap">
        <span class="lightbox__event" data-lightbox-event></span>
        <span class="lightbox__detail" data-lightbox-cap></span>
        <span class="lightbox__count" data-lightbox-count></span>
      </figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
    </button>
  </dialog>
</Section>

<style>
  /* ---- Team ---- */
  .team { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
  .team__card {
    position: relative; display: grid; align-content: start; gap: var(--space-4);
    padding: clamp(1.5rem, 3vw, 2.5rem); border: 1px solid var(--line); background: var(--surface);
    opacity: 0;
  }
  .team__logo { height: 2rem; width: auto; margin-bottom: var(--space-4); }
  .team__mark { font-size: 2rem; font-weight: 200; letter-spacing: 0.1em; line-height: 1; margin-bottom: var(--space-4); }
  .team__name { font-size: var(--text-xl); font-weight: 400; letter-spacing: -0.01em; }
  .team__text { font-weight: 300; color: var(--fg-dim); }
  .team__link { margin-top: var(--space-2); font-size: var(--text-sm); letter-spacing: 0.05em; }
  .team__link:hover { text-decoration: underline; text-underline-offset: 0.3em; }
  .team__focus { display: grid; margin-top: var(--space-2); border-top: 1px solid var(--line); }
  .team__focus li { display: flex; gap: var(--space-4); padding-block: var(--space-3); border-bottom: 1px solid var(--line); font-size: var(--text-sm); }
  .team__focus-no { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-dim); padding-top: 0.2em; }

  /* ---- Block head ---- */
  .block { margin-top: clamp(5rem, 10vw, 8rem); }
  .block__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-6); margin-bottom: var(--space-8); }
  .block__title { margin-top: var(--space-4); font-size: var(--text-xl); font-weight: 300; letter-spacing: -0.01em; }
  .block__lede { max-width: 28rem; font-size: var(--text-sm); font-weight: 300; color: var(--fg-dim); text-align: right; }
  @media (max-width: 640px) { .block__head { flex-direction: column; align-items: flex-start; } .block__lede { text-align: left; } }

  /* ---- Frames ---- */
  .frames {
    display: grid; gap: var(--space-3);
    grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(10rem, 24vw); grid-auto-flow: dense;
  }
  @media (min-width: 768px) { .frames { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(11rem, 17vw); } }
  .frame { position: relative; opacity: 0; }
  .frame--wide { grid-column: span 2; }
  .frame__btn { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; border: 1px solid var(--line); background: var(--surface); text-align: left; }
  .frame__btn :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: transform 0.9s var(--ease-out), filter 0.5s; }
  .frame__btn:hover :global(img), .frame__btn:focus-visible :global(img) { transform: scale(1.04); filter: grayscale(0.7) contrast(1.05); }
  .frame__cap {
    position: absolute; inset: auto 0 0 0; display: grid; gap: 0.3rem; padding: var(--space-3) var(--space-4);
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.85)); pointer-events: none;
  }
  .frame__meta { display: flex; align-items: center; gap: var(--space-2); font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--fg); }
  .frame__meta b { font-weight: 500; }
  .frame__meta i { width: 1.2rem; height: 1px; background: var(--line-strong); }
  .frame__detail { font-size: var(--text-xs); color: var(--fg-dim); opacity: 0; transform: translateY(4px); transition: opacity 0.4s, transform 0.4s var(--ease-out); }
  .frame__btn:hover .frame__detail, .frame__btn:focus-visible .frame__detail { opacity: 1; transform: none; }
  @media (hover: none) { .frame__detail { opacity: 1; transform: none; } }

  /* ---- Lightbox ---- */
  .lightbox {
    border: 0; padding: 0; margin: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh;
    background: rgba(0, 0, 0, 0.96); color: var(--fg); display: none; place-items: center;
  }
  .lightbox[open] { display: grid; }
  .lightbox::backdrop { background: transparent; }
  .lightbox__figure { display: grid; gap: var(--space-4); width: min(92vw, 1400px); max-height: 90vh; align-content: center; justify-items: center; }
  .lightbox__img { max-width: 100%; max-height: 74vh; object-fit: contain; filter: grayscale(1) contrast(1.05); }
  .lightbox__cap { display: grid; justify-items: center; gap: 0.35rem; text-align: center; }
  .lightbox__event { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; text-transform: uppercase; }
  .lightbox__detail { font-size: var(--text-sm); color: var(--fg-dim); max-width: 48rem; }
  .lightbox__count { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-mute); }
  .lightbox__close, .lightbox__nav {
    position: absolute; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center;
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .lightbox__close:hover, .lightbox__nav:hover { background: var(--fg); color: var(--bg); }
  .lightbox__close { top: var(--gutter); right: var(--gutter); }
  .lightbox__nav { top: 50%; transform: translateY(-50%); }
  .lightbox__nav--prev { left: var(--gutter); }
  .lightbox__nav--next { right: var(--gutter); }
  @media (max-width: 640px) { .lightbox__nav { top: auto; bottom: var(--gutter); transform: none; } }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('#organisers', () => import('./island'));
</script>
