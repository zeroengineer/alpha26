---
/**
 * The Team — who builds ALPHA, then Track Record (previous events) and In Frames (photo collage).
 * Nothing sits in a tidy column: cards hold opposite corners, events alternate sides with image and
 * text drifting at different speeds, and frames float at different sizes and depths over the α
 * stage's plan view.
 */
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/Section/Section.astro';
import { organisers } from '@/content/organisers';
import { resolveImage } from '@/lib/images';
import mss from '@/assets/brand/ieee-mss-lockup.png';

const events = (await getCollection('pastEvents')).map((e) => e.data);
const gallery = await Promise.all(
  (await getCollection('gallery')).map(async (g) => {
    const meta = resolveImage(g.data.image.src);
    const full = await getImage({ src: meta, format: 'webp', width: 1800, quality: 82 });
    return { ...g.data, meta, full: full.src };
  }),
);
/** collage placement: [column start, span, top offset (vh), speed] on a 12-column field */
const collage: [number, number, number, number][] = [
  [1, 5, 0, 0.9], [8, 4, 10, 1.18], [3, 3, 6, 1.05], [7, 5, 2, 0.86],
  [1, 4, 14, 1.2], [6, 3, 0, 0.94], [10, 3, 18, 1.1], [2, 5, 4, 0.88],
  [8, 4, 0, 1.16], [4, 4, 12, 0.98],
];
---
<Section id="organisers" heading={organisers.heading} eyebrow={organisers.eyebrow} align="right" station="team" class="org">
  <div class="team" data-organisers>
    <article class="team__card team__card--a" data-team-card data-soft data-speed="0.9">
      <Image class="team__logo" src={mss} alt="" width={438} height={88} />
      <h3 class="team__name">{organisers.org.name}</h3>
      <p class="team__text">{organisers.org.description}</p>
      <a class="team__link" href={organisers.org.url} target="_blank" rel="noreferrer">
        {organisers.org.url.replace('https://', '')} <span aria-hidden="true">↗</span>
      </a>
    </article>
    <article class="team__card team__card--b" data-team-card data-soft data-speed="1.15">
      <span class="team__mark metal-text" aria-hidden="true">IRC</span>
      <h3 class="team__name">{organisers.committee.name}</h3>
      <p class="team__text">{organisers.committee.description}</p>
      <p class="team__link team__link--static">Organisers of {`ALPHA '26`}</p>
    </article>
  </div>

  <!-- Track Record -->
  <div class="block" id="track-record">
    <header class="block__head">
      <p class="section-no" data-soft>Previous events</p>
      <h3 class="block__title" data-block-title>{organisers.pastEventsHeading}</h3>
    </header>
    <ol class="events">
      {events.map((e, i) => (
        <li class:list={['event', { 'event--flip': i % 2 === 1 }]} data-event>
          <figure class="event__media" data-soft data-speed={i % 2 ? 1.12 : 0.88}>
            <Image src={resolveImage(e.cover.src)} alt={e.cover.alt} widths={[480, 800, 1200]} sizes="(max-width: 768px) 90vw, 44vw" loading="lazy" decoding="async" />
          </figure>
          <div class="event__body" data-soft data-speed={i % 2 ? 0.92 : 1.12}>
            <span class="event__year">{e.year}</span>
            <h4 class="event__name">{e.name}</h4>
            <p class="event__tag section-no">{e.tagline}</p>
            <p class="event__summary">{e.summary}</p>
            {e.stats && (
              <ul class="event__stats">
                {e.stats.map((s) => (
                  <li><span class="event__stat-value metal-text">{s.value}</span><span class="event__stat-label">{s.label}</span></li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>

  <!-- In Frames -->
  <div class="block" id="gallery" data-station="frames">
    <header class="block__head block__head--center">
      <p class="section-no" data-soft>Gallery</p>
      <h3 class="block__title" data-block-title>{organisers.galleryHeading}</h3>
    </header>
    <ul class="collage" data-gallery>
      {gallery.map((g, i) => {
        const [col, span, top, speed] = collage[i % collage.length];
        return (
          <li class="frame" style={`--col:${col};--span:${span};--top:${top}vh`} data-gallery-item data-soft data-speed={speed}>
            <button type="button" class="frame__btn" data-lightbox-open={i} data-full={g.full} data-alt={g.image.alt} aria-label={`Open image: ${g.image.alt}`}>
              <Image src={g.meta} alt={g.image.alt} widths={[400, 700, 1000]} sizes="(max-width: 768px) 90vw, 40vw" loading="lazy" decoding="async" />
            </button>
          </li>
        );
      })}
    </ul>
  </div>

  <dialog class="lightbox" data-lightbox aria-label="Image viewer">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <button class="lightbox__nav lightbox__nav--prev" type="button" data-lightbox-prev aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M20 12H4m6-6-6 6 6 6"/></svg>
    </button>
    <figure class="lightbox__figure">
      <img class="lightbox__img" data-lightbox-img alt="" />
      <figcaption class="lightbox__cap"><span data-lightbox-cap></span><span class="lightbox__count" data-lightbox-count></span></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next image">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
    </button>
  </dialog>
</Section>

<style>
  /* ---- Team: opposite corners, different depths ---- */
  .team { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); row-gap: 4rem; }
  .team__card {
    display: grid; align-content: start; gap: var(--space-4); padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line); background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  }
  .team__card--a { grid-column: 1 / span 5; }
  .team__card--b { grid-column: 8 / span 5; margin-top: 24vh; }
  @media (max-width: 900px) { .team__card--a, .team__card--b { grid-column: 1 / -1; margin-top: 0; } .team__card--b { margin-left: 10%; } }
  .team__logo { height: 2rem; width: auto; margin-bottom: var(--space-4); }
  .team__mark { font-size: 2rem; font-weight: 200; letter-spacing: 0.1em; line-height: 1; margin-bottom: var(--space-4); }
  .team__name { font-size: var(--text-xl); font-weight: 300; letter-spacing: 0.02em; text-transform: uppercase; }
  .team__text { font-weight: 300; color: var(--fg-dim); }
  .team__link { margin-top: var(--space-2); font-size: var(--text-sm); letter-spacing: 0.05em; }
  .team__link:not(.team__link--static):hover { text-decoration: underline; text-underline-offset: 0.3em; }
  .team__link--static { color: var(--fg-dim); }

  /* ---- Blocks ---- */
  .block { margin-top: clamp(10rem, 30vh, 20rem); }
  .block__head { display: grid; gap: var(--space-4); margin-bottom: clamp(4rem, 12vh, 8rem); }
  .block__head--center { justify-items: center; text-align: center; }
  .block__title {
    font-size: clamp(2rem, 1rem + 4vw, 4.8rem); font-weight: 200; text-transform: uppercase; letter-spacing: 0.03em; line-height: 1;
    background: var(--metal); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; opacity: 0;
  }
  .block__title :global(.line) { background: inherit; -webkit-background-clip: text; background-clip: text; }

  /* ---- Track Record: alternating, depth-split entries ---- */
  .events { display: grid; gap: clamp(8rem, 24vh, 16rem); }
  .event { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); align-items: center; column-gap: var(--space-8); }
  .event__media { grid-column: 1 / span 6; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line); }
  .event__body { grid-column: 8 / span 4; display: grid; gap: var(--space-3); text-shadow: 0 0 22px #000; }
  .event--flip .event__media { grid-column: 7 / span 6; grid-row: 1; }
  .event--flip .event__body { grid-column: 2 / span 4; grid-row: 1; }
  .event__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); }
  .event__year { font-family: var(--font-display); font-size: clamp(2.5rem, 1.5rem + 3vw, 4.5rem); letter-spacing: 0.15em; line-height: 1; color: var(--fg-mute); }
  .event__name { font-size: var(--text-xl); font-weight: 300; text-transform: uppercase; letter-spacing: 0.03em; }
  .event__summary { font-size: var(--text-sm); font-weight: 300; color: var(--fg-dim); }
  .event__stats { display: flex; gap: var(--space-8); margin-top: var(--space-2); }
  .event__stats li { display: grid; gap: 2px; }
  .event__stat-value { font-size: var(--text-xl); font-weight: 200; line-height: 1; }
  .event__stat-label { font-size: var(--text-xs); letter-spacing: 0.15em; text-transform: uppercase; color: var(--fg-dim); }
  @media (max-width: 900px) {
    .event__media, .event--flip .event__media { grid-column: 1 / -1; grid-row: 1; }
    .event__body, .event--flip .event__body { grid-column: 1 / -1; grid-row: 2; margin-top: var(--space-6); }
  }

  /* ---- In Frames: floating collage ---- */
  .collage { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-6); row-gap: clamp(3rem, 10vh, 7rem); align-items: start; }
  .frame { grid-column: var(--col) / span var(--span); margin-top: var(--top); }
  .frame:nth-child(3n + 2) .frame__btn { aspect-ratio: 3 / 4; }
  .frame__btn { display: block; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .frame__btn :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: transform 1.2s var(--ease-out), filter 0.6s; }
  .frame__btn:hover :global(img), .frame__btn:focus-visible :global(img) { transform: scale(1.05); filter: grayscale(0.6) contrast(1.05); }
  @media (max-width: 760px) {
    .block { margin-top: 8rem; }
    .events { gap: 6rem; }
    .collage { row-gap: 1.5rem; }
    .frame { grid-column: 1 / -1; margin-top: 0; }
    .frame:nth-child(even) { grid-column: 4 / -1; }
  }

  /* ---- Lightbox ---- */
  .lightbox { border: 0; padding: 0; margin: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.96); color: var(--fg); display: none; place-items: center; }
  .lightbox[open] { display: grid; }
  .lightbox::backdrop { background: transparent; }
  .lightbox__figure { display: grid; gap: var(--space-4); width: min(92vw, 1400px); max-height: 90vh; align-content: center; justify-items: center; }
  .lightbox__img { max-width: 100%; max-height: 78vh; object-fit: contain; filter: grayscale(1) contrast(1.05); }
  .lightbox__cap { display: flex; gap: var(--space-6); font-size: var(--text-sm); color: var(--fg-dim); }
  .lightbox__count { font-family: var(--font-mono); letter-spacing: 0.2em; }
  .lightbox__close, .lightbox__nav { position: absolute; width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: background var(--dur-fast), color var(--dur-fast); }
  .lightbox__close:hover, .lightbox__nav:hover { background: var(--fg); color: var(--bg); }
  .lightbox__close { top: var(--gutter); right: var(--gutter); }
  .lightbox__nav { top: 50%; transform: translateY(-50%); }
  .lightbox__nav--prev { left: var(--gutter); }
  .lightbox__nav--next { right: var(--gutter); }
  @media (max-width: 640px) { .lightbox__nav { top: auto; bottom: var(--gutter); transform: none; } }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('#organisers', () => import('./island'));
</script>
