---
/**
 * The Lineup (flag: speakers). Spotlight slider of speakers with the 01 —— 0N counter,
 * then the sessions grouped by day. Rendered only when features.speakers is true.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Section from '@/components/Section/Section.astro';
import { site, features } from '@/content/site';
import { resolveImage } from '@/lib/images';

const speakers = (await getCollection('speakers')).map((s) => s.data);
const sessions = (await getCollection('sessions')).map((s) => s.data).sort((a, b) => a.day - b.day || a.time.localeCompare(b.time));
const days = [...new Set(sessions.map((s) => s.day))];
const byId = new Map(speakers.map((s) => [s.id, s]));
const kindLabel: Record<string, string> = { keynote: 'Keynote', workshop: 'Workshop', panel: 'Panel', talk: 'Talk', networking: 'Networking' };
---
<Section id="speakers" heading="The Lineup" eyebrow="Speakers & sessions" class="lineup">
  <div class="block" id="lineup">
    <header class="block__head">
      <p class="block__lede">The professionals in the room — and the sessions they are bringing.</p>
      <p class="slider__counter" aria-hidden="true"><span data-slider-current>01</span><i></i><span data-slider-total>{String(speakers.length).padStart(2, '0')}</span></p>
    </header>

    <div class="slider" data-slider tabindex="0" aria-roledescription="carousel" aria-label="Speakers">
      <ul class="slider__track" data-slider-track data-lenis-prevent>
        {speakers.map((sp, i) => (
          <li class="speaker" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${speakers.length}`}>
            <figure class="speaker__media">
              <Image src={resolveImage(sp.photo.src)} alt={sp.photo.alt} widths={[400, 700]} sizes="(max-width: 768px) 70vw, 20rem" loading="lazy" decoding="async" />
            </figure>
            <div class="speaker__body" data-slide-body>
              <h3 class="speaker__name">{sp.name}</h3>
              <p class="speaker__role">{sp.role}</p>
              <p class="speaker__org eyebrow">{sp.org}</p>
              {sp.links?.linkedin && <a class="speaker__link" href={sp.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>}
            </div>
          </li>
        ))}
      </ul>
      <div class="slider__foot">
        <div class="slider__progress"><i data-slider-progress></i></div>
        <div class="slider__btns">
          <button class="slider__btn" type="button" data-slider-prev aria-label="Previous speaker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M20 12H4m6-6-6 6 6 6"/></svg>
          </button>
          <button class="slider__btn" type="button" data-slider-next aria-label="Next speaker">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.25"><path d="M4 12h16m-6-6 6 6-6 6"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="block" id="sessions">
    <header class="block__head">
      <div>
        <p class="section-no"><span>Schedule</span>{features.dates && <span class="block__eyebrow">{site.dates.display}</span>}</p>
        <h3 class="block__title metal-text">Sessions</h3>
      </div>
    </header>
    <div class="days">
      {days.map((day) => (
        <section class="day" aria-labelledby={`day-${day}`}>
          <h4 class="day__title" id={`day-${day}`}><span class="day__no">Day {String(day).padStart(2, '0')}</span></h4>
          <ol class="day__list">
            {sessions.filter((s) => s.day === day).map((s) => (
              <li class="session" data-session>
                <time class="session__time">{s.time}</time>
                <div class="session__body">
                  <p class="session__kind eyebrow">{kindLabel[s.kind] ?? s.kind}</p>
                  <h5 class="session__title">{s.title}</h5>
                  <p class="session__summary">{s.summary}</p>
                  {s.speakerIds.length > 0 && (
                    <p class="session__speakers">{s.speakerIds.map((id) => byId.get(id)?.name).filter(Boolean).join(' · ')}</p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Section>

<style>
  .block + .block { margin-top: clamp(5rem, 10vw, 8rem); }
  .block__head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-6); margin-bottom: var(--space-8); }
  .block__lede { max-width: 32rem; font-weight: 300; color: var(--fg-dim); }
  .block__eyebrow { margin-left: var(--space-2); }
  .block__title { margin-top: var(--space-4); font-size: var(--text-xl); font-weight: 300; }

  /* Slider (shared look with Track Record) */
  .slider__track {
    --pad: max(var(--gutter), calc((100vw - var(--container)) / 2));
    --slide-w: min(70vw, 20rem);
    display: flex; gap: var(--space-6);
    width: 100vw; margin-left: calc(-1 * var(--pad)); padding-inline: var(--pad);
    /* Enough end padding for the last slide to reach the snap start, so every slide can be "current". */
    padding-inline-end: max(var(--pad), calc(100vw - var(--slide-w) - var(--pad)));
    overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad);
    scrollbar-width: none; cursor: grab;
  }
  .slider__track::-webkit-scrollbar { display: none; }
  .slider__track.is-dragging { scroll-snap-type: none; cursor: grabbing; user-select: none; }
  .speaker { flex: 0 0 var(--slide-w); scroll-snap-align: start; display: grid; gap: var(--space-4); }
  .speaker__media { aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .speaker__media :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: transform 1.2s var(--ease-out), filter 0.6s; transform: scale(1.04); }
  .speaker.is-active .speaker__media :global(img) { transform: scale(1); }
  .speaker__media:hover :global(img) { filter: grayscale(0.8); }
  .speaker__body { display: grid; gap: var(--space-1); }
  .speaker__name { font-size: var(--text-lg); font-weight: 500; }
  .speaker__role { font-weight: 300; color: var(--fg-dim); }
  .speaker__org { margin-top: var(--space-2); }
  .speaker__link { margin-top: var(--space-3); font-size: var(--text-sm); letter-spacing: 0.05em; }
  .speaker__link:hover { text-decoration: underline; text-underline-offset: 0.3em; }

  .slider__counter { display: flex; align-items: center; gap: var(--space-3); font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.2em; color: var(--fg-dim); }
  .slider__counter [data-slider-current] { color: var(--fg); }
  .slider__counter i { width: 2.5rem; height: 1px; background: var(--line-strong); }
  .slider__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); margin-top: var(--space-8); }
  .slider__progress { flex: 1; height: 1px; background: var(--line); }
  .slider__progress i { display: block; height: 100%; background: var(--fg); transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease-out); }
  .slider__btns { display: flex; gap: var(--space-3); }
  .slider__btn { width: 3rem; height: 3rem; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: background var(--dur-fast), border-color var(--dur-fast), opacity var(--dur-fast); }
  .slider__btn:hover:not(:disabled) { background: var(--fg); color: var(--bg); border-color: var(--fg); }
  .slider__btn:disabled { opacity: 0.3; cursor: default; }

  /* Sessions */
  .days { display: grid; gap: var(--space-12); }
  @media (min-width: 900px) { .days { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-8); } }
  .day__title { padding-bottom: var(--space-4); border-bottom: 1px solid var(--line-strong); }
  .day__no { font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.2em; text-transform: uppercase; }
  .session { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: var(--space-4); padding-block: var(--space-6); border-bottom: 1px solid var(--line); opacity: 0; }
  .session__time { font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.1em; color: var(--fg-dim); padding-top: 0.2em; }
  .session__body { display: grid; gap: var(--space-2); }
  .session__title { font-size: var(--text-lg); font-weight: 500; }
  .session__summary { font-size: var(--text-sm); font-weight: 300; color: var(--fg-dim); }
  .session__speakers { font-size: var(--text-sm); }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('#speakers', () => import('./island'));
</script>
