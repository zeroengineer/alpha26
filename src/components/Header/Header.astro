---
/** Poster header: IEEE Malabar Subsection lockup left, IEEE logo right (both white-on-transparent). */
import { Image } from 'astro:assets';
import mss from '@/assets/brand/ieee-mss-lockup.png';
import ieee from '@/assets/brand/ieee.png';
---
<header class="header" data-header>
  <a class="header__brand" href="#hero" aria-label="IEEE Malabar Subsection — back to top">
    <Image src={mss} alt="IEEE Malabar Subsection" width={438} height={88} loading="eager" />
  </a>
  <slot />
  <a class="header__ieee" href="https://www.ieee.org" target="_blank" rel="noreferrer" aria-label="IEEE">
    <Image src={ieee} alt="IEEE" width={411} height={120} loading="eager" />
  </a>
</header>

<style>
  .header {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav);
    display: flex; align-items: center; justify-content: space-between;
    height: var(--nav-h); padding-inline: var(--gutter);
    opacity: 0; /* revealed after the preloader */
  }
  :global(html[data-revealed='true']) .header { opacity: 1; transition: opacity 1s var(--ease-out) 0.2s; }
  .header__brand img { height: clamp(1.6rem, 2.8vw, 2.5rem); width: auto; }
  .header__ieee img { height: clamp(1.9rem, 3.2vw, 3rem); width: auto; }
</style>
