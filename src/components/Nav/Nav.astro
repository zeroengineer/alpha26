---
/**
 * Top bar: IEEE MSS lockup left, section links centred, IEEE logo right — the poster header.
 * Transparent over the hero, translucent black with a hairline once scrolled. On small screens the
 * links collapse into a full-screen overlay menu. Links for flagged-off sections are not rendered.
 */
import { Image } from 'astro:assets';
import mss from '@/assets/brand/ieee-mss-lockup.png';
import ieee from '@/assets/brand/ieee.png';
import { features, site } from '@/content/site';
import { buildNav, sectionNumber } from '@/lib/nav';
import { ALPHA_PATH, ALPHA_VIEWBOX } from '@/assets/alpha/alpha-path';

const items = buildNav(features);
---
<header class="nav" data-nav>
  <a class="nav__brand" href="#hero" data-nav-link="hero" aria-label="IEEE Malabar Subsection — back to top">
    <Image src={mss} alt="IEEE Malabar Subsection" width={438} height={88} loading="eager" />
  </a>

  <nav class="nav__links" aria-label="Sections">
    <ul>
      {items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-nav-link={item.id}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <a class="nav__ieee" href="https://www.ieee.org" target="_blank" rel="noreferrer" aria-label="IEEE">
    <Image src={ieee} alt="IEEE" width={411} height={120} loading="eager" />
  </a>

  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="menu" data-nav-toggle>
    <span class="sr-only">Menu</span>
    <i></i><i></i>
  </button>
</header>

<div class="menu" id="menu" data-menu hidden>
  <nav aria-label="Sections">
    <ul class="menu__list">
      {items.map((item) => (
        <li>
          <a class="menu__link" href={`#${item.id}`} data-nav-link={item.id} data-menu-link>
            <span class="menu__no">{item.id === 'hero' ? '00' : sectionNumber(item.id, features)}</span>
            <span class="menu__label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <p class="menu__foot eyebrow">{site.name} · {site.tagline}</p>
  <!-- transit: shown while a tapped link carries the visitor to its section -->
  <div class="menu__transit" data-menu-transit aria-hidden="true">
    <svg class="menu__transit-alpha" viewBox={`0 0 ${ALPHA_VIEWBOX.w} ${ALPHA_VIEWBOX.h}`}>
      <path d={ALPHA_PATH} pathLength="1" data-transit-stroke />
    </svg>
    <p class="menu__transit-label"><span class="menu__transit-no" data-transit-no>01</span><span data-transit-label>About</span></p>
    <span class="menu__transit-bar"><i data-transit-bar></i></span>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: var(--z-nav);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    height: var(--nav-h); padding-inline: var(--gutter);
    opacity: 0; transition: background var(--dur-fast), border-color var(--dur-fast);
    border-bottom: 1px solid transparent;
  }
  
  :global(html[data-ready='true']) .nav { opacity: 1; transition: opacity 1s var(--ease-out) 0.2s, background var(--dur-fast), border-color var(--dur-fast); }
  .nav.is-scrolled { background: rgba(0, 0, 0, 0.72); border-color: var(--line); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); }

  .nav__brand img { height: clamp(1.5rem, 2.6vw, 2.4rem); width: auto; }
  .nav__ieee { justify-self: end; }
  .nav__ieee img { height: clamp(1.8rem, 3vw, 2.9rem); width: auto; }

  .nav__links ul { display: flex; gap: clamp(1rem, 2.4vw, 2.5rem); }
  .nav__links a {
    position: relative; display: block; padding: 0.4em 0.1em;
    font-size: var(--text-xs); font-weight: 500; letter-spacing: var(--track-nav); text-transform: uppercase;
    color: var(--fg-dim); transition: color var(--dur-fast);
  }
  .nav__links a::after {
    content: ''; position: absolute; left: 50%; bottom: 0; width: 3px; height: 3px; border-radius: 50%;
    background: var(--fg); transform: translateX(-50%) scale(0); transition: transform 0.3s var(--ease-out);
  }
  .nav__links a:hover, .nav__links a.is-active { color: var(--fg); }
  .nav__links a.is-active::after { transform: translateX(-50%) scale(1); }

  .nav__toggle {
    display: none; justify-self: end; width: 44px; height: 44px; margin-left: var(--space-3);
    place-items: center; position: relative;
  }
  .nav__toggle i { position: absolute; left: 11px; width: 22px; height: 1px; background: var(--fg); transition: transform 0.4s var(--ease-out), top 0.4s var(--ease-out); }
  .nav__toggle i:nth-child(2) { top: 18px; }
  .nav__toggle i:nth-child(3) { top: 26px; }
  .nav__toggle[aria-expanded='true'] i:nth-child(2) { top: 22px; transform: rotate(45deg); }
  .nav__toggle[aria-expanded='true'] i:nth-child(3) { top: 22px; transform: rotate(-45deg); }

  .menu {
    position: fixed; inset: 0; z-index: calc(var(--z-nav) - 1); background: var(--bg); /* below the bar so the toggle stays reachable */
    display: grid; align-content: center; justify-items: start; gap: var(--space-12);
    padding: calc(var(--nav-h) + var(--space-8)) var(--gutter) var(--space-12);
    clip-path: inset(0 0 100% 0);
  }
  .menu[hidden] { display: none; }
  .menu__list { display: grid; gap: var(--space-4); }
  .menu__link { display: flex; align-items: baseline; gap: var(--space-4); padding-block: var(--space-2); }
  .menu__no { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-dim); }
  .menu__label { font-size: clamp(2rem, 9vw, 3.5rem); font-weight: 300; letter-spacing: -0.01em; line-height: 1.1; }
  .menu__link.is-active .menu__label { font-weight: 500; }
  .menu__foot { letter-spacing: var(--track-wide); }
  .menu__transit {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: var(--space-6);
    pointer-events: none; visibility: hidden;
  }
  .menu__transit-alpha { width: min(46vw, 13rem); height: auto; overflow: visible; }
  .menu__transit-alpha path { fill: none; stroke: var(--fg); stroke-width: 1.2; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .menu__transit-label { display: flex; align-items: baseline; gap: var(--space-3); font-size: var(--text-xl); font-weight: 300; text-transform: uppercase; letter-spacing: 0.08em; }
  .menu__transit-no { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-dim); }
  .menu__transit-bar { width: min(50vw, 12rem); height: 1px; background: var(--line); overflow: hidden; }
  .menu__transit-bar i { display: block; height: 100%; background: var(--fg); transform: scaleX(0); transform-origin: left; }

  @media (max-width: 860px) {
    .nav { grid-template-columns: 1fr auto auto; }
    .nav__links { display: none; }
    .nav__toggle { display: grid; }
  }
  @media (min-width: 861px) {
    .menu { display: none !important; }
  }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-nav]', () => import('./island'), { strategy: 'load' });
</script>
