---
/** Throwaway: tall section under the spike heroes so the scroll scrub can be felt. Deleted after Phase 1. */
interface Props { variant: 'gsap' | 'webgl' }
const { variant } = Astro.props;
const other = variant === 'gsap' ? 'webgl' : 'gsap';
---
<section class="filler container">
  <p class="section-no">Spike · hero variant {variant}</p>
  <h2>Scroll back up to replay the scrub.</h2>
  <p>
    Compare with <a href={`/spike/hero-${other}?pre=1`}>the {other} variant</a>. Add <code>?pre=1</code> to a URL
    to replay the preloader.
  </p>
</section>
<style>
  .filler { min-height: 120svh; display: grid; align-content: start; gap: var(--space-6); padding-block: var(--section-y); }
  h2 { font-size: var(--text-xl); font-weight: 500; }
  a { text-decoration: underline; text-underline-offset: 0.3em; }
  code { font-family: var(--font-mono); color: var(--fg-dim); }
</style>
