---
/**
 * Hero — the poster, centred. As the visitor scrolls it recedes (scales down, softens, fades) and
 * hands over to the 3D α on the stage behind it, which sits in the same place.
 * First paint: a still rendered from the live α stage (scripts/capture-hero.mjs) — α, glass slats and
 * crosshairs, no crowd — so the hand-off to the live scene is pixel-identical.
 */
import { Picture } from 'astro:assets';
import poster from '@/assets/figma/alpha-render.png';
import HeroText from './HeroText.astro';
---
<section id="hero" class="hero" data-hero data-station="hero" data-station-at="top" aria-label="ALPHA '26 — coming soon">
  <div class="hero__frame" data-hero-frame>
    <div class="hero__scene" data-scene aria-hidden="true">
      <div class="layer layer--base" data-depth="0.35">
        <Picture
          src={poster}
          alt=""
          formats={['avif', 'webp']}
          widths={[720, 1080, 1620]}
          sizes="(max-width: 768px) 130vw, 90vh"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
    <div class="vignette vignette--top"></div>
    <div class="vignette vignette--bottom"></div>
  </div>
  <HeroText />
  <p class="hero__cue" data-cue aria-hidden="true"><span>Scroll</span><i></i></p>
</section>

<style>
  .hero {
    position: relative; height: 100svh; overflow: hidden; background: transparent;
    /* Landscape: poster is 115% of the viewport height, centred. Portrait: covers the width. */
    --poster-h: 115svh;
    --poster-w: calc(var(--poster-h) * 0.75);
    --copy-w: min(var(--poster-w), 100vw);
  }
  @media (orientation: portrait) {
    .hero { --poster-h: max(100svh, calc(100vw / 0.75)); }
  }
  .hero__frame { position: absolute; inset: 0; will-change: transform, opacity, filter; }
  .hero__scene { position: absolute; inset: 0; z-index: var(--z-hero-scene); opacity: 0; }
  /* Centred with margins, not `translate`: GSAP resets the individual translate/rotate/scale
     properties on elements it animates, which would un-centre the poster. */
  .layer {
    position: absolute; left: 50%; top: 50%; width: var(--poster-w); height: var(--poster-h);
    margin-left: calc(var(--poster-w) / -2); margin-top: calc(var(--poster-h) / -2); will-change: transform;
  }
  .layer--base :global(img) { width: 100%; height: 100%; object-fit: cover; }
  /* feather the poster's edges into the stage on wide screens */
  .layer--base { -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }


  .hero__cue {
    position: absolute; right: var(--gutter); bottom: 2rem; z-index: var(--z-content);
    display: flex; align-items: center; gap: 0.75rem; opacity: 0;
    font-size: var(--text-xs); letter-spacing: var(--track-eyebrow); text-transform: uppercase; color: var(--fg-dim);
  }
  .hero__cue i { width: 1px; height: 2.5rem; background: linear-gradient(var(--fg), transparent); animation: cue 2.4s var(--ease-in-out) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (max-width: 640px) { .hero__cue { display: none; } }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-hero]', () => import('./island'), { strategy: 'load' });
</script>
