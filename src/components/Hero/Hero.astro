---
/**
 * Hero — a three-step, wheel-driven sequence (zrk pattern) over the poster artwork:
 *   0  poster + caption + COMING SOON
 *   1  key facts glitch in while the poster dims
 *   2  the closing statement wipes in; the next gesture releases normal scrolling
 * Layers: poster raster, six CSS glass slats, crosshair ticks and a light sweep as depth layers
 * (cursor parallax). Reduced motion: no sequence — the three scenes stack in normal flow.
 */
import { Picture } from 'astro:assets';
import poster from '@/assets/figma/alpha-crowd.png';
import { site } from '@/content/site';
import HeroText from './HeroText.astro';
import Hud from '@/components/Hud/Hud.astro';
const slats = [0, 1, 2, 3, 4, 5];
const steps = [0, 1, 2];
---
<section id="hero" class="hero" data-hero aria-label="ALPHA '26 — coming soon">
  <div class="hero__stage" data-stage>
    <div class="hero__poster" data-poster>
      <div class="hero__scene" data-scene aria-hidden="true">
        <div class="layer layer--base" data-depth="0.35">
          <Picture
            src={poster}
            alt=""
            formats={['avif', 'webp']}
            widths={[720, 1080, 1620]}
            sizes="(max-width: 768px) 130vw, 90vh"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="layer layer--slats" data-depth="0.9" data-slats>
          {slats.map((i) => <i class="slat" style={`--i:${i}`} data-slat></i>)}
        </div>
        <div class="layer layer--ticks" data-depth="1.5">
          <span class="tick" style="left:14%; top:46%"></span>
          <span class="tick" style="left:78%; top:17%"></span>
          <span class="tick" style="left:60%; top:82%"></span>
        </div>
        <div class="sweep" data-sweep></div>
      </div>
      <div class="vignette vignette--top"></div>
      <div class="vignette vignette--bottom"></div>
      <HeroText />
      <Hud />
    </div>

    <!-- Step 1: key facts -->
    <div class="hero__facts" data-hero-scene="1" aria-hidden="true">
      <ul class="facts">
        {site.about.facts.map((f) => (
          <li class="fact" data-fact>
            <span class="fact__value metal-text" data-letters>{f.value}</span>
            <span class="fact__label eyebrow" data-fact-label>{f.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Step 2: statement -->
    <div class="hero__statement" data-hero-scene="2" aria-hidden="true">
      <p class="statement display metal-text wipe" data-statement>
        <span class="wipe__text">{site.about.closing}</span>
        <i class="wipe__block" aria-hidden="true"></i>
      </p>
    </div>

    <!-- Progress strip -->
    <div class="hero__progress" data-hero-progress aria-hidden="true">
      <span class="hero__ticks">
        {steps.map((s) => <i class:list={['hero__tick', { 'is-active': s === 0 }]} data-tick={s}></i>)}
      </span>
      <span class="hero__count"><b data-step-count>01</b> / 03</span>
      <span class="hero__hint" data-hint>Scroll</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; background: transparent;
    /* Landscape: poster is 115% of the viewport height, centred, black sides blend into the ground.
       Portrait: poster covers the viewport width instead. --copy-w keeps the type inside the viewport. */
    --poster-h: 115svh;
    --poster-w: calc(var(--poster-h) * 0.75);
    --copy-w: min(var(--poster-w), 100vw);
  }
  @media (orientation: portrait) {
    .hero { --poster-h: max(100svh, calc(100vw / 0.75)); }
  }
  .hero__stage { position: relative; height: 100svh; overflow: hidden; }
  .hero__poster { position: relative; height: 100svh; }
  .hero__scene { position: absolute; inset: 0; z-index: var(--z-hero-scene); opacity: 0; transform: scale(1.1); will-change: transform, filter; }
  /* Centred with margins, not `translate`: GSAP 3.13+ resets individual transform properties
     (translate/rotate/scale) on elements it animates, which would un-centre the layers. */
  .layer {
    position: absolute; left: 50%; top: 50%; width: var(--poster-w); height: var(--poster-h);
    margin-left: calc(var(--poster-w) / -2); margin-top: calc(var(--poster-h) / -2); will-change: transform;
  }
  .layer--base :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .slat {
    position: absolute; top: 8.5%; height: 83%; width: 11%;
    left: calc(13.5% + var(--i) * 13%);
    transform: skewY(-2deg) scaleY(0); transform-origin: center;
    background: linear-gradient(180deg, rgba(255,255,255,0.16) 0%, rgba(255,255,255,0.02) 35%, rgba(255,255,255,0.03) 70%, rgba(255,255,255,0.1) 100%);
    backdrop-filter: blur(1.2px) brightness(1.14) contrast(1.06);
    -webkit-backdrop-filter: blur(1.2px) brightness(1.14) contrast(1.06);
    border-left: 1px solid rgba(255,255,255,0.38);
    border-right: 1px solid rgba(255,255,255,0.06);
    box-shadow: inset 0 0 50px rgba(255,255,255,0.05), 0 0 30px rgba(0,0,0,0.35);
  }
  .slat::after { content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; background: linear-gradient(90deg, rgba(255,255,255,0.9), rgba(255,255,255,0.1)); }

  .tick { position: absolute; width: 14px; height: 14px; opacity: 0.6; }
  .tick::before, .tick::after { content: ''; position: absolute; background: var(--fg); }
  .tick::before { left: 50%; top: 0; width: 1px; height: 100%; }
  .tick::after { top: 50%; left: 0; height: 1px; width: 100%; }

  .sweep {
    position: absolute; inset: 0;
    background: linear-gradient(100deg, transparent 42%, rgba(255,255,255,0.16) 50%, transparent 58%);
    mix-blend-mode: screen; transform: translateX(-120%); pointer-events: none;
  }

  /* ---- Overlay scenes ---- */
  .hero__facts, .hero__statement {
    position: absolute; inset: 0; z-index: var(--z-content);
    display: grid; place-content: center; padding: calc(var(--nav-h) + 2rem) var(--gutter) 6rem;
    visibility: hidden; opacity: 0; pointer-events: none;
  }
  .facts { display: grid; gap: clamp(1.5rem, 4vw, 3.5rem); grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 76rem); }
  @media (min-width: 1200px) { .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .fact { display: grid; gap: var(--space-3); padding-top: var(--space-4); border-top: 1px solid var(--line-strong); min-width: 0; }
  .fact__value { font-size: clamp(1.9rem, 0.4rem + 2.9vw, 4.2rem); font-weight: 200; letter-spacing: -0.02em; line-height: 1; white-space: nowrap; }
  .fact__value :global(.char) { display: inline-block; opacity: 0; }
  .fact__label { opacity: 0; }

  .statement {
    position: relative; width: min(100%, 60rem); text-align: center;
    font-size: clamp(1.1rem, 0.6rem + 1.9vw, 2.3rem); letter-spacing: 0.3em; text-indent: 0; line-height: 1.7;
    text-transform: uppercase; text-wrap: balance; --ghost: 0; --ghost-a: 0;
  }
  .statement .wipe__text { opacity: 0; }
  .statement .wipe__block { position: absolute; inset: 0; background: var(--fg); transform: scaleX(0); transform-origin: left center; }

  /* ---- Progress strip ---- */
  .hero__progress {
    position: absolute; left: 50%; bottom: calc(1.2rem + env(safe-area-inset-bottom)); z-index: var(--z-content); translate: -50% 0;
    display: flex; align-items: center; gap: var(--space-4);
    font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-dim); opacity: 0;
  }
  .hero__ticks { display: flex; gap: 4px; }
  .hero__tick { width: 2px; height: 14px; background: var(--line-strong); transition: background 0.4s, transform 0.4s var(--ease-out); }
  .hero__tick.is-active { background: var(--fg); transform: scaleY(1.3); }
  .hero__count b { font-weight: 500; color: var(--fg); }
  .hero__hint { text-transform: uppercase; animation: hint 2.4s var(--ease-in-out) infinite; }
  @keyframes hint { 0%, 100% { opacity: 0.4; } 50% { opacity: 1; } }

  /* ---- Reduced motion: no sequence, scenes stack in flow ---- */
  @media (prefers-reduced-motion: reduce) {
    .hero__stage { height: auto; overflow: visible; }
    .hero__facts, .hero__statement { position: relative; inset: auto; visibility: visible; opacity: 1; padding-block: var(--section-y); }
    .fact__value :global(.char), .fact__label, .statement .wipe__text { opacity: 1; }
    .hero__progress { display: none; }
  }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-hero]', () => import('./island'), { strategy: 'load' });
</script>
