---
/**
 * 01 — The Programme. The brief's three paragraphs with line reveals and the four pillars.
 * (Key facts and the closing statement now live in the hero sequence.)
 */
import Section from '@/components/Section/Section.astro';
import { site } from '@/content/site';
const { about } = site;
---
<Section id="about" heading={about.heading} eyebrow={about.eyebrow} class="about">
  <div class="about__copy" data-about>
    {about.paragraphs.map((p, i) => (
      <p class:list={['about__p', { 'about__p--lede': i === 0 }]} data-reveal>{p}</p>
    ))}
  </div>

  <ol class="pillars" aria-label="What the programme is built from">
    {about.pillars.map((pillar, i) => (
      <li class="pillar" data-pillar>
        <span class="pillar__no">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="pillar__title">{pillar.title}</h3>
        <p class="pillar__text">{pillar.text}</p>
      </li>
    ))}
  </ol>
</Section>

<style>
  .about__copy { display: grid; gap: var(--space-6); max-width: 46rem; }
  .about__p { font-weight: 300; color: var(--fg-dim); font-size: var(--text-base); opacity: 0; }
  .about__p--lede { font-size: var(--text-lg); color: var(--fg); }

  .pillars {
    display: grid; gap: 0; margin-top: clamp(4rem, 8vw, 7rem);
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    border-top: 1px solid var(--line);
  }
  .pillar {
    position: relative; display: grid; align-content: start; gap: var(--space-3);
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
    border-bottom: 1px solid var(--line); opacity: 0;
  }
  @media (min-width: 900px) {
    .pillar + .pillar { padding-left: var(--space-6); border-left: 1px solid var(--line); }
  }
  .pillar__no { font-family: var(--font-mono); font-size: var(--text-xs); letter-spacing: 0.2em; color: var(--fg-dim); }
  .pillar__title { font-size: var(--text-lg); font-weight: 500; letter-spacing: -0.01em; }
  .pillar__text { font-size: var(--text-sm); font-weight: 300; color: var(--fg-dim); }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-about]', () => import('./island'));
</script>
