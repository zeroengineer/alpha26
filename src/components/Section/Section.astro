---
/**
 * Chapter shell for every block below the hero. No panels, no numbered counters: the α stage shows
 * through, the head is an α-marked eyebrow plus a large light heading that focuses in line by line.
 *   align   where the head sits (left / right / center) — chapters alternate to break the column
 *   station the α-stage camera stop this chapter's head corresponds to
 */
interface Props {
  id: string;
  heading: string;
  eyebrow: string;
  class?: string;
  align?: 'left' | 'right' | 'center';
  station?: string;
}
const { id, heading, eyebrow, class: className = '', align = 'left', station } = Astro.props;
---
<section id={id} class:list={['section', `section--${align}`, className]} data-section aria-labelledby={`${id}-title`}>
  <div class="container">
    <header class="section__head" data-station={station}>
      <p class="section-no" data-soft data-section-eyebrow>{eyebrow}</p>
      <h2 class="section__title" id={`${id}-title`} data-section-title>{heading}</h2>
    </header>
    <slot />
  </div>
</section>

<style>
  .section { position: relative; padding-block: clamp(6rem, 16vh, 12rem); scroll-margin-top: var(--nav-h); }
  .section__head { display: grid; gap: var(--space-6); max-width: 60rem; margin-bottom: clamp(4rem, 14vh, 9rem); }
  .section--right .section__head { margin-left: auto; text-align: right; justify-items: end; }
  .section--center .section__head { margin-inline: auto; text-align: center; justify-items: center; }
  .section__title {
    font-size: clamp(2.6rem, 1rem + 6vw, 7rem); font-weight: 200; letter-spacing: 0.02em; line-height: 0.98;
    text-transform: uppercase; opacity: 0;
    background: var(--metal); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
  }
  .section__title :global(.line) { background: inherit; -webkit-background-clip: text; background-clip: text; }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-section]', () => import('./island'));
</script>
