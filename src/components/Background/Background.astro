---
/**
 * Persistent monochrome background behind the whole page.
 * CSS: faint perspective grid + vignette (what reduced-motion / no-WebGL visitors see).
 * WebGL (island, after the preloader, on idle): a breathing particle "crowd field" with a faint grid,
 * brightening near the cursor, camera dollying per scene (see src/lib/scene-bus.ts).
 */
---
<div class="bg" data-bg aria-hidden="true">
  <canvas class="bg__canvas" data-bg-canvas></canvas>
</div>

<style>
  .bg {
    position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden;
    background:
      radial-gradient(ellipse 70% 55% at 50% 62%, rgba(255, 255, 255, 0.045), transparent 70%),
      var(--bg);
  }
  /* CSS fallback grid: a flat perspective floor drawn with gradients, masked to fade at the edges */
  .bg::before {
    content: ''; position: absolute; inset: 0;
    background:
      repeating-linear-gradient(90deg, var(--line) 0 1px, transparent 1px calc(100% / 12)),
      repeating-linear-gradient(180deg, var(--line) 0 1px, transparent 1px calc(100% / 8));
    opacity: 0.55;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 55%, #000 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 55%, #000 30%, transparent 80%);
  }
  .bg.is-webgl::before { opacity: 0; transition: opacity 1.2s; }
  .bg__canvas { width: 100%; height: 100%; display: block; opacity: 0; transition: opacity 1.8s var(--ease-out); }
  .bg__canvas.is-on { opacity: 1; }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  import { onReveal, reducedMotion } from '@/lib/motion/core';
  // Heavy chunk: only after the preloader has handed over, on idle, and never for reduced motion.
  onReveal(() => {
    if (reducedMotion()) return;
    defineIsland('[data-bg]', () => import('./island'), { strategy: 'idle' });
  });
</script>
