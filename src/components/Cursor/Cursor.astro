---
/** Crosshair cursor follower (desktop fine pointers only). Native cursor is hidden while it is active. */
---
<div class="cursor" data-cursor aria-hidden="true">
  <i class="cursor__h"></i><i class="cursor__v"></i><i class="cursor__dot"></i><i class="cursor__ring"></i>
</div>

<style>
  .cursor { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor {
      display: block; position: fixed; left: 0; top: 0; z-index: 200; width: 22px; height: 22px; margin: -11px 0 0 -11px;
      pointer-events: none; mix-blend-mode: difference; opacity: 0;
    }
    .cursor i { position: absolute; background: #fff; }
    .cursor__h { left: 0; top: 50%; width: 100%; height: 1px; }
    .cursor__v { top: 0; left: 50%; height: 100%; width: 1px; }
    .cursor__dot { left: 50%; top: 50%; width: 3px; height: 3px; margin: -1.5px 0 0 -1.5px; border-radius: 50%; }
    .cursor .cursor__ring { inset: -9px; border: 1px solid #fff; border-radius: 50%; background: transparent; opacity: 0; transform: scale(0.6); transition: opacity 0.3s, transform 0.4s var(--ease-out); }
    .cursor.is-hover .cursor__ring { opacity: 0.9; transform: scale(1); }
    .cursor.is-hover .cursor__h, .cursor.is-hover .cursor__v { transform: scale(0.5); }
    :global(html.has-cursor), :global(html.has-cursor *) { cursor: none !important; }
  }
  @media (prefers-reduced-motion: reduce) { .cursor { display: none; } }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  defineIsland('[data-cursor]', () => import('./island'), { strategy: 'idle' });
</script>
