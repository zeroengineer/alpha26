---
/**
 * The α stage — a persistent background behind the whole page.
 * WebGL: a chrome + wireframe α (GFS Didot outline, extruded), a swirling point "crowd" in the bowl and a faint floor grid. The camera flies between
 * stations as the visitor scrolls (see stations.ts).
 * Phones and small screens (`lite()`): no WebGL at all — the α outline below is drawn as an SVG wireframe that
 * tours the same stations (lite.ts).
 * Fallback (reduced motion / no WebGL2): the same outline, large, faint and still.
 */
import { ALPHA_PATH, ALPHA_VIEWBOX } from '@/assets/alpha/alpha-path';
---
<div class="stage" data-stage aria-hidden="true">
  <div class="stage__glow"></div>
  <!-- lite.ts draws copies of this outline at different depths (an SVG wireframe) -->
  <div class="stage__alpha" data-stage-alpha>
    <svg class="stage__fallback" viewBox={`0 0 ${ALPHA_VIEWBOX.w} ${ALPHA_VIEWBOX.h}`} preserveAspectRatio="xMidYMid meet">
      <path d={ALPHA_PATH} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
    </svg>
  </div>
  <canvas class="stage__canvas" data-stage-canvas></canvas>
  <div class="stage__fog"></div>
</div>

<style>
  .stage { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: var(--bg); }
  .stage__alpha { position: absolute; inset: 0; display: grid; place-items: center; }
  .stage__fallback { width: min(70vw, 90vh); height: auto; color: var(--fg); opacity: 0.09; transition: opacity 1.2s; }
  .stage.is-webgl .stage__fallback { opacity: 0; }
  .stage__glow { position: absolute; inset: 0; opacity: 0; background: radial-gradient(ellipse 60% 45% at 50% 50%, rgba(255, 255, 255, 0.07), transparent 70%); }

  /* ---- phones / small screens: an SVG wireframe α (no canvas) — the layers are built and projected in lite.ts ---- */
  .stage.is-lite .stage__canvas { display: none; }
  .stage.is-lite .stage__fallback { width: min(84vw, 80vh); opacity: 0; overflow: visible; transition: none; }
  .stage.is-lite .stage__glow { animation: stage-glow 9s var(--ease-in-out) infinite alternate; }
  @keyframes stage-glow { from { opacity: 0.35; } to { opacity: 1; } }
  .stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease-out); }
  .stage__canvas.is-on { opacity: 1; }
  /* atmospheric vignette, same recipe as the poster's blurred black bands */
  .stage__fog {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 70% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.75) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, transparent 18%, transparent 82%, rgba(0, 0, 0, 0.65) 100%);
  }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  import { onReady, reducedMotion, lite } from '@/lib/motion/core';
  // The live scene is built straight away, while the opening loader is still on screen (the loader
  // waits for it — see Loader/island.ts), so the page opens with the 3D already running instead of a
  // still that is swapped out a few seconds later, and none of the build lands on the first scroll.
  // The build yields between its heavy steps, so the loader's own animation keeps moving.
  // Phones and small screens never load the 3D scene (or three.js): they get the light wireframe.
  if (!reducedMotion() && lite()) {
    onReady(() => defineIsland('[data-stage]', () => import('./lite'), { strategy: 'load' }));
  } else if (!reducedMotion()) {
    defineIsland('[data-stage]', () => import('./island'), { strategy: 'load' });
  }
</script>
