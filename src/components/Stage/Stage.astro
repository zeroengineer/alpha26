---
/**
 * The α stage — a persistent background behind the whole page.
 * WebGL: a chrome + wireframe α (GFS Didot outline, extruded), the poster's six glass slats as wire
 * planes, a swirling point "crowd" in the bowl and a faint floor grid. The camera flies between
 * stations as the visitor scrolls (see stations.ts).
 * Fallback (reduced motion / no WebGL2): a large, faint α outline.
 */
import { ALPHA_PATH, ALPHA_VIEWBOX } from '@/assets/alpha/alpha-path';
---
<div class="stage" data-stage aria-hidden="true">
  <svg class="stage__fallback" viewBox={`0 0 ${ALPHA_VIEWBOX.w} ${ALPHA_VIEWBOX.h}`} preserveAspectRatio="xMidYMid meet">
    <path d={ALPHA_PATH} fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
  </svg>
  <canvas class="stage__canvas" data-stage-canvas></canvas>
  <div class="stage__fog"></div>
</div>

<style>
  .stage { position: fixed; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; background: var(--bg); }
  .stage__fallback {
    position: absolute; left: 50%; top: 50%; width: min(70vw, 90vh); height: auto; translate: -50% -50%;
    color: var(--fg); opacity: 0.09; transition: opacity 1.2s;
  }
  .stage.is-webgl .stage__fallback { opacity: 0; }
  .stage__canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease-out); }
  .stage__canvas.is-on { opacity: 1; }
  /* atmospheric vignette, same recipe as the poster's blurred black bands */
  .stage__fog {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 70% at 50% 50%, transparent 40%, rgba(0, 0, 0, 0.75) 100%),
      linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, transparent 18%, transparent 82%, rgba(0, 0, 0, 0.65) 100%);
  }
</style>

<script>
  import { defineIsland } from '@/lib/island';
  import { onReady, reducedMotion } from '@/lib/motion/core';
  // The first-paint still and the live scene are composed identically, so the live scene can take
  // over whenever it is ready. It is built after the first interaction (a mouse move counts on
  // desktop — including one made while the loader plays) or after a few seconds, and never before
  // the page is ready, so it stays off the initial load.
  if (!reducedMotion()) {
    let wanted = false;
    let mounted = false;
    const events = ['scroll', 'wheel', 'touchstart', 'pointerdown', 'pointermove', 'keydown'] as const;
    const mount = () => {
      if (mounted) return;
      mounted = true;
      defineIsland('[data-stage]', () => import('./island'), { strategy: 'load' });
    };
    const want = () => {
      if (wanted) return;
      wanted = true;
      events.forEach((e) => window.removeEventListener(e, want));
      onReady(mount);
    };
    events.forEach((e) => window.addEventListener(e, want, { passive: true }));
    onReady(() => {
      if (window.scrollY > 0) want();
      setTimeout(want, 6000);
    });
  }
</script>
